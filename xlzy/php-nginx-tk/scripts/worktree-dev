#!/usr/bin/env bash
# 管理多个 Codex worktree 的 API 路由、依赖库注册和显式绑定。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
NGINX_CONF_DIR="$(cd "${ROOT_DIR}/../mynginx/conf" && pwd)"
GENERATED_CONF="${NGINX_CONF_DIR}/zz-worktrees.conf"
STATE_DIR="${ROOT_DIR}/runtime/worktree-dev"
API_DIR="${STATE_DIR}/apis"; LIB_DIR="${STATE_DIR}/libraries"; BIND_DIR="${STATE_DIR}/bindings"
COMPOSE_FILE="${ROOT_DIR}/docker-compose.yml"
HOST_WORKSPACE_ROOT="${HOST_WORKSPACE_ROOT:-${HOME}/myproject/xlzy}"
HOST_CODEX_ROOT="${HOME}/.codex/worktrees"
source "${ROOT_DIR}/config/worktree-projects.sh"
mkdir -p "$API_DIR" "$LIB_DIR" "$BIND_DIR"

die() { echo "错误：$*" >&2; exit 1; }
info() { echo "==> $*"; }
compose() { docker compose -f "$COMPOSE_FILE" "$@"; }
valid_name() { [[ "$1" =~ ^[a-z0-9]+([a-z0-9-]*[a-z0-9]+)?$ ]]; }

# 仅在交互终端启用颜色，保证管道和脚本调用得到纯文本。
init_output_style() {
  STYLE_RESET='' STYLE_TITLE='' STYLE_TASK='' STYLE_OK='' STYLE_MUTED=''
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    STYLE_RESET=$'\033[0m'
    STYLE_TITLE=$'\033[1;36m'
    STYLE_TASK=$'\033[1;33m'
    STYLE_OK=$'\033[1;32m'
    STYLE_MUTED=$'\033[2m'
  fi
}

# 将当前用户目录缩写为 ~，减少本地 worktree 路径的视觉噪音。
short_host_path() {
  case "$1" in
    "$HOME") printf '~\n' ;;
    "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}
canonical_path() { [ -d "$1" ] || die "目录不存在：$1"; (cd "$1" && pwd -P); }
container_path() {
  local path; path="$(canonical_path "$1")"
  case "$path" in
    "${HOST_CODEX_ROOT}"/*) printf '/worktrees/codex/%s\n' "${path#"${HOST_CODEX_ROOT}/"}" ;;
    "${HOST_WORKSPACE_ROOT}"/*) printf '/www/%s\n' "${path#"${HOST_WORKSPACE_ROOT}/"}" ;;
    *) die "路径未挂载到容器：$path" ;;
  esac
}
api_state() { printf '%s/%s/%s.state\n' "$API_DIR" "$1" "$2"; }
lib_state() { printf '%s/%s/%s.state\n' "$LIB_DIR" "$1" "$2"; }
bind_state() { printf '%s/%s/%s.state\n' "$BIND_DIR" "$1" "$2"; }
load_file() { [ -f "$1" ] || die "注册信息不存在：$1"; source "$1"; }
project_has_library() { local x; for x in $(project_libraries "$1"); do [ "$x" = "$2" ] && return 0; done; return 1; }
library_key() { case "$1" in tkslib) echo TKSLIB;; mcnlib) echo MCNLIB;; cmclib) echo CMCLIB;; *) die "未知库：$1";; esac; }
usage() { cat <<'EOF'
用法：
  worktree-dev api-up <项目> <API工作区ID> --api <路径> [--task <任务名>]
  worktree-dev set-task <项目> <API工作区ID或任务名> <任务名>
  worktree-dev lib-up <库名> <库工作区ID> --path <路径> [--task <任务名>]
  worktree-dev bind <项目> <API工作区ID或任务名> --lib <库名>=<库工作区ID或任务名> [--lib ...]
  worktree-dev unbind <项目> <API工作区ID或任务名> --lib <库名>
  worktree-dev api-down <项目> <API工作区ID或任务名>
  worktree-dev lib-down <库名> <库工作区ID或任务名>
  worktree-dev reload
  worktree-dev list
  worktree-dev cli <项目> <API工作区ID或任务名> <yii 参数...>
EOF
}

write_api_state() {
  local f created_at task_name
  f="$(api_state "$1" "$2")"; created_at="${6:-$(date '+%Y-%m-%d %H:%M:%S %z')}"; task_name="${5:--}"
  mkdir -p "$(dirname "$f")"
  printf 'PROJECT=%q\nAPI_ID=%q\nAPI_HOST=%q\nAPI_CONTAINER=%q\nTASK_NAME=%q\nCREATED_AT=%q\n' "$1" "$2" "$3" "$4" "$task_name" "$created_at" > "$f"
}
write_lib_state() { local f task; f="$(lib_state "$1" "$2")"; task="${5:--}"; mkdir -p "$(dirname "$f")"; printf 'LIBRARY=%q\nLIB_ID=%q\nLIB_HOST=%q\nLIB_CONTAINER=%q\nTASK_NAME=%q\nCREATED_AT=%q\n' "$1" "$2" "$3" "$4" "$task" "$(date '+%Y-%m-%d %H:%M:%S')" > "$f"; }

# 已设置任务名时以任务名作为域名键；旧记录未设置任务名时仍兼容 worktree ID。
api_route_key() {
  local api_id="$1" task_name="${2:--}"
  [ "$task_name" = '-' ] && printf '%s\n' "$api_id" || printf '%s\n' "$task_name"
}

# 同一项目下的任务名即域名的一部分，必须保持唯一。
assert_api_route_available() {
  local project="$1" api_id="$2" task_name="$3" file existing_id existing_task route_key
  route_key="$(api_route_key "$api_id" "$task_name")"
  for file in "$API_DIR/${project}"/*.state; do
    [ -f "$file" ] || continue
    unset API_ID TASK_NAME; source "$file"
    existing_id="$API_ID"; existing_task="${TASK_NAME:--}"
    [ "$existing_id" = "$api_id" ] && continue
    [ "$(api_route_key "$existing_id" "$existing_task")" = "$route_key" ] || continue
    die "域名已被 API worktree 占用：${project}--${route_key}.localtest.me（${existing_id}）"
  done
}

resolve_api_id() {
  local project="$1" reference="$2" file found=''
  [ -f "$(api_state "$project" "$reference")" ] && { printf '%s\n' "$reference"; return; }
  for file in "$API_DIR/${project}"/*.state; do
    [ -f "$file" ] || continue; unset API_ID TASK_NAME; source "$file"
    [ "${TASK_NAME:--}" = "$reference" ] || continue
    [ -z "$found" ] || die "任务名对应多个 API worktree：$reference"
    found="$API_ID"
  done
  [ -n "$found" ] || die "未找到 API worktree：${project}/${reference}"; printf '%s\n' "$found"
}
resolve_lib_id() {
  local library="$1" reference="$2" file found=''
  [ -f "$(lib_state "$library" "$reference")" ] && { printf '%s\n' "$reference"; return; }
  for file in "$LIB_DIR/${library}"/*.state; do
    [ -f "$file" ] || continue; unset LIB_ID TASK_NAME; source "$file"
    [ "${TASK_NAME:--}" = "$reference" ] || continue
    [ -z "$found" ] || die "任务名对应多个库 worktree：$reference"
    found="$LIB_ID"
  done
  [ -n "$found" ] || die "未找到库 worktree：${library}/${reference}"; printf '%s\n' "$found"
}
library_target() {
  local project="$1" api_id="$2" library="$3" key id
  key="$(library_key "$library")"
  if [ -f "$(bind_state "$project" "$api_id")" ]; then
    unset LIB_ID; source "$(bind_state "$project" "$api_id")"; eval "id=\${LIB_${key}_ID:-}"
    if [ -n "${id:-}" ]; then unset LIB_CONTAINER; load_file "$(lib_state "$library" "$id")"; printf '%s\n' "$LIB_CONTAINER"; return; fi
  fi
  library_fallback "$library"
}
write_binding() {
  local project="$1" api_id="$2" target_library="$3" target_id="$4" file tmp library key value
  file="$(bind_state "$project" "$api_id")"; mkdir -p "$(dirname "$file")"; tmp="${file}.tmp"
  unset LIB_TKSLIB_ID LIB_MCNLIB_ID LIB_CMCLIB_ID
  [ -f "$file" ] && source "$file"
  for library in $(project_libraries "$project"); do
    key="$(library_key "$library")"; eval "value=\${LIB_${key}_ID:-}"
    [ "$library" = "$target_library" ] && value="$target_id"
    [ -n "${value:-}" ] && printf 'LIB_%s_ID=%q\n' "$key" "$value"
  done > "$tmp"
  mv "$tmp" "$file"
}

# 删除某个库的显式绑定；未绑定的库将由 library_target() 回退到主工作区。
remove_binding() {
  local project="$1" api_id="$2" target_library="$3" file tmp library key value found=0
  file="$(bind_state "$project" "$api_id")"
  [ -f "$file" ] || die "API 未绑定库：${target_library}"
  unset LIB_TKSLIB_ID LIB_MCNLIB_ID LIB_CMCLIB_ID
  source "$file"
  key="$(library_key "$target_library")"; eval "value=\${LIB_${key}_ID:-}"
  [ -n "${value:-}" ] || die "API 未绑定库：${target_library}"
  tmp="${file}.tmp"
  for library in $(project_libraries "$project"); do
    key="$(library_key "$library")"; eval "value=\${LIB_${key}_ID:-}"
    [ "$library" = "$target_library" ] && continue
    [ -n "${value:-}" ] && { printf 'LIB_%s_ID=%q\n' "$key" "$value"; found=1; }
  done > "$tmp"
  if [ "$found" -eq 1 ]; then mv "$tmp" "$file"; else rm -f "$tmp" "$file"; fi
}

auto_bind_api() {
  local project="$1" api_id="$2" library lib_id
  unset TASK_NAME; load_file "$(api_state "$project" "$api_id")"
  [ "${TASK_NAME:--}" != '-' ] || return
  for library in $(project_libraries "$project"); do
    if lib_id="$(resolve_lib_id "$library" "$TASK_NAME" 2>/dev/null)"; then write_binding "$project" "$api_id" "$library" "$lib_id"; fi
  done
}
ensure_link() {
  local link="$1" target="$2" existing
  if [ -L "$link" ]; then [ "$(readlink "$link")" = "$target" ] || { rm "$link"; ln -s "$target" "$link"; }; return; fi
  if [ -e "$link" ]; then existing="$(container_path "$link")"; [ "$existing" = "$target" ] || die "目录被占用：$link"; return; fi
  ln -s "$target" "$link"
}
sync_api_links() {
  local project="$1" id="$2" parent library; unset API_HOST; load_file "$(api_state "$project" "$id")"; parent="$(dirname "$API_HOST")"
  ensure_link "${parent}/vendor" '/www/vendor'
  for library in $(project_libraries "$project"); do ensure_link "${parent}/${library}" "$(library_target "$project" "$id" "$library")"; done
}
cleanup_api_links() {
  local project="$1" id="$2" file parent other; file="$(api_state "$project" "$id")"; unset API_HOST; load_file "$file"; parent="$(dirname "$API_HOST")"
  for other in "$API_DIR"/*/*.state; do
    [ -f "$other" ] || continue; [ "$other" = "$file" ] && continue
    if ( unset API_HOST; source "$other"; [ "$(dirname "$API_HOST")" = "$parent" ] ); then return; fi
  done
  rm -f "${parent}/vendor" "${parent}/tkslib" "${parent}/mcnlib" "${parent}/cmclib"
}
generate_nginx() {
  local tmp f; tmp="$(mktemp "${GENERATED_CONF}.XXXXXX")"
  {
    echo '# 由 worktree-dev 自动生成，请勿手工编辑。'
    for f in "$API_DIR"/*/*.state; do
      [ -f "$f" ] || continue; unset PROJECT API_ID API_CONTAINER TASK_NAME; source "$f"
      cat <<EOF
server {
    listen 80;
    server_name ${PROJECT}--$(api_route_key "$API_ID" "${TASK_NAME:--}").localtest.me;
    root ${API_CONTAINER}/web;
    index index.php;
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location ~ \\.php\$ {
        include fastcgi_params;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
    }
}

EOF
    done
  } > "$tmp"; printf '%s\n' "$tmp"
}
reload_nginx() {
  local candidate backup; candidate="$(generate_nginx)"; backup="${GENERATED_CONF}.bak"
  [ -f "$GENERATED_CONF" ] && cp "$GENERATED_CONF" "$backup" || true; mv "$candidate" "$GENERATED_CONF"
  # Codex 创建 worktree 时 Docker 可能尚未启动；配置已落盘，容器启动后会自动加载。
  if ! compose ps --status running -q nginx | rg -q .; then
    rm -f "$backup"; info 'Nginx 未运行，路由将在容器启动后生效'; return 0
  fi
  if ! compose exec -T nginx nginx -t; then [ -f "$backup" ] && mv "$backup" "$GENERATED_CONF" || rm -f "$GENERATED_CONF"; return 1; fi
  rm -f "$backup"; compose exec -T nginx nginx -s reload
}
cmd_api_up() {
  local p="$1" id="$2"; shift 2; local host='' container='' task_name='-' option
  [ -n "$(project_repository "$p" 2>/dev/null || true)" ] || die "未知项目：$p"; valid_name "$id" || die '无效工作区ID'
  while [ "$#" -gt 0 ]; do
    option="$1"; shift
    case "$option" in
      --api) host="$(canonical_path "${1:-}")"; shift ;;
      --task) task_name="${1:-}"; shift; [ -n "$task_name" ] || die '任务名不能为空' ;;
      *) die "未知参数：$option" ;;
    esac
  done
  [ -n "$host" ] || die '缺少 --api'
  [ "$task_name" = '-' ] || valid_name "$task_name" || die '任务名只能包含小写字母、数字和连字符'
  [ -f "${host}/web/index.php" ] || die '不是 Yii Web 项目'; [ "$(basename "$host")" = "$(project_repository "$p")" ] || die '项目目录名不匹配'
  assert_api_route_available "$p" "$id" "$task_name"
  container="$(container_path "$host")"; write_api_state "$p" "$id" "$host" "$container" "$task_name"; auto_bind_api "$p" "$id"; sync_api_links "$p" "$id"; reload_nginx || die 'Nginx 校验失败，未注册路由'; info "已注册 [${task_name}]：http://${p}--$(api_route_key "$id" "$task_name").localtest.me:8080"
}
cmd_set_task() {
  local p="$1" id task_name="$3"; id="$(resolve_api_id "$p" "$2")"
  valid_name "$task_name" || die '任务名只能包含小写字母、数字和连字符'
  unset API_HOST API_CONTAINER CREATED_AT; load_file "$(api_state "$p" "$id")"
  assert_api_route_available "$p" "$id" "$task_name"
  write_api_state "$p" "$id" "$API_HOST" "$API_CONTAINER" "$task_name" "${CREATED_AT:-$(date '+%Y-%m-%d %H:%M:%S %z')}"; auto_bind_api "$p" "$id"; sync_api_links "$p" "$id"; reload_nginx || die 'Nginx 校验失败，任务名未更新'
  info "已标注任务：${p}/${id} → ${task_name}（http://${p}--${task_name}.localtest.me:8080）"
}
cmd_lib_up() {
  local lib="$1" id="$2"; shift 2; local host='' task_name='-' option file p api_id
  library_fallback "$lib" >/dev/null || die "未知库：$lib"; valid_name "$id" || die '无效工作区ID'
  while [ "$#" -gt 0 ]; do option="$1"; shift; case "$option" in --path) host="$(canonical_path "${1:-}")"; shift;; --task) task_name="${1:-}"; shift;; *) die "未知参数：$option";; esac; done
  [ "$task_name" = '-' ] || valid_name "$task_name" || die '任务名只能包含小写字母、数字和连字符'
  [ -n "$host" ] || die '缺少 --path'; write_lib_state "$lib" "$id" "$host" "$(container_path "$host")" "$task_name"
  # 库稍后创建时，自动绑定所有同任务名且依赖该库的 API。
  if [ "$task_name" != '-' ]; then for file in "$API_DIR"/*/*.state; do [ -f "$file" ] || continue; unset PROJECT API_ID TASK_NAME; source "$file"; p="$PROJECT"; api_id="$API_ID"; if [ "${TASK_NAME:--}" = "$task_name" ] && project_has_library "$p" "$lib"; then write_binding "$p" "$api_id" "$lib" "$id"; sync_api_links "$p" "$api_id"; fi; done; reload_nginx || die 'Nginx 校验失败，库注册未完成'; fi
  info "已注册库 [${task_name}]：${lib}/${id}"
}
cmd_bind() {
  local p="$1" id; id="$(resolve_api_id "$p" "$2")"; shift 2; local opt value lib lid
  load_file "$(api_state "$p" "$id")"
  while [ "$#" -gt 0 ]; do
    opt="$1"; shift; [ "$opt" = '--lib' ] || die "未知参数：$opt"; value="$1"; shift; lib="${value%%=*}"; lid="${value#*=}"
    [ "$lib" != "$value" ] || die '--lib 格式必须为 库名=工作区ID'; project_has_library "$p" "$lib" || die "项目未声明库：$lib"; lid="$(resolve_lib_id "$lib" "$lid")"; write_binding "$p" "$id" "$lib" "$lid"
  done
  sync_api_links "$p" "$id"; reload_nginx || die 'Nginx 校验失败，绑定未生效'; info "已绑定：${p}/${id}"
}
cmd_unbind() {
  local p="$1" id option lib
  id="$(resolve_api_id "$p" "$2")"; option="$3"; lib="$4"
  [ "$option" = '--lib' ] || die "未知参数：$option"
  project_has_library "$p" "$lib" || die "项目未声明库：$lib"
  remove_binding "$p" "$id" "$lib"; sync_api_links "$p" "$id"
  info "已解除绑定：${p}/${id} → ${lib}（已回退主工作区）"
}
cmd_api_down() { local id="$(resolve_api_id "$1" "$2")"; cleanup_api_links "$1" "$id"; rm -f "$(api_state "$1" "$id")" "$(bind_state "$1" "$id")"; reload_nginx || die 'Nginx 校验失败'; }
cmd_lib_down() {
  local lib="$1" id; id="$(resolve_lib_id "$lib" "$2")"; [ -f "$(lib_state "$lib" "$id")" ] || die '库 worktree 未注册'
  if rg -l "^LIB_$(library_key "$lib")_ID=${id}$" "$BIND_DIR" >/dev/null 2>&1; then die '该库仍被 API 绑定，请先清理或改绑 API'; fi
  rm -f "$(lib_state "$lib" "$id")"; info "已移除库：${lib}/${id}"
}

# 返回 API 已绑定的库列表；未绑定时由调用方展示主工作区回退状态。
api_binding_summary() {
  local project="$1" api_id="$2" library key value output=''
  [ -f "$(bind_state "$project" "$api_id")" ] || return 0
  unset LIB_TKSLIB_ID LIB_MCNLIB_ID LIB_CMCLIB_ID
  source "$(bind_state "$project" "$api_id")"
  for library in $(project_libraries "$project"); do
    key="$(library_key "$library")"; eval "value=\${LIB_${key}_ID:-}"
    [ -n "${value:-}" ] && output="${output}${output:+、}${library}/${value}"
  done
  printf '%s\n' "$output"
}

# 返回正在使用指定库 worktree 的 API 列表，供库卡片显示反向关联。
library_reference_summary() {
  local library="$1" id="$2" key file value project api_id output=''
  key="$(library_key "$library")"
  for file in "$BIND_DIR"/*/*.state; do
    [ -f "$file" ] || continue
    unset LIB_TKSLIB_ID LIB_MCNLIB_ID LIB_CMCLIB_ID
    source "$file"; eval "value=\${LIB_${key}_ID:-}"
    [ "${value:-}" = "$id" ] || continue
    project="$(basename "$(dirname "$file")")"; api_id="$(basename "${file%.state}")"
    output="${output}${output:+、}${project}/${api_id}"
  done
  printf '%s\n' "$output"
}

cmd_list() {
  local f created_at bindings references path count=0
  init_output_style
  printf '%sAPI worktree：%s\n' "$STYLE_TITLE" "$STYLE_RESET"
  for f in "$API_DIR"/*/*.state; do
    [ -f "$f" ] || continue; count=$((count + 1)); unset PROJECT API_ID API_HOST TASK_NAME CREATED_AT; source "$f"
    created_at="${CREATED_AT:--}"; created_at="${created_at%% +*}"
    path="$(short_host_path "$API_HOST")"; bindings="$(api_binding_summary "$PROJECT" "$API_ID")"
    [ -n "$bindings" ] || bindings='未绑定（使用主工作区库）'
    printf '  %s%s/%s%s  %s[%s]%s  %s\n' "$STYLE_OK" "$PROJECT" "$API_ID" "$STYLE_RESET" "$STYLE_TASK" "${TASK_NAME:--}" "$STYLE_RESET" "$created_at"
    printf '  %s路径：%s%s\n' "$STYLE_MUTED" "$path" "$STYLE_RESET"
    printf '  %s关联：%s%s\n\n' "$STYLE_MUTED" "$bindings" "$STYLE_RESET"
  done
  [ "$count" -gt 0 ] || printf '  %s（暂无）%s\n\n' "$STYLE_MUTED" "$STYLE_RESET"
  printf '%s库 worktree：%s\n' "$STYLE_TITLE" "$STYLE_RESET"; count=0
  for f in "$LIB_DIR"/*/*.state; do
    [ -f "$f" ] || continue; count=$((count + 1)); unset LIBRARY LIB_ID LIB_HOST TASK_NAME CREATED_AT; source "$f"
    created_at="${CREATED_AT:--}"; created_at="${created_at%% +*}"
    path="$(short_host_path "$LIB_HOST")"; references="$(library_reference_summary "$LIBRARY" "$LIB_ID")"
    [ -n "$references" ] || references='未被 API 关联'
    printf '  %s%s/%s%s  %s[%s]%s  %s\n' "$STYLE_OK" "$LIBRARY" "$LIB_ID" "$STYLE_RESET" "$STYLE_TASK" "${TASK_NAME:--}" "$STYLE_RESET" "$created_at"
    printf '  %s路径：%s%s\n' "$STYLE_MUTED" "$path" "$STYLE_RESET"
    printf '  %s被关联：%s%s\n\n' "$STYLE_MUTED" "$references" "$STYLE_RESET"
  done
  [ "$count" -gt 0 ] || printf '  %s（暂无）%s\n' "$STYLE_MUTED" "$STYLE_RESET"
}
cmd_cli() { local p="$1" id; id="$(resolve_api_id "$p" "$2")"; shift 2; unset API_CONTAINER; load_file "$(api_state "$p" "$id")"; compose exec -T php sh -lc "cd '${API_CONTAINER}' && exec php yii-test \"\$@\"" -- "$@"; }
migrate_legacy_states() {
  local f
  # 兼容旧版 runtime/worktree-dev/<项目>--<ID>.state 状态文件。
  for f in "$STATE_DIR"/*.state; do
    [ -f "$f" ] || continue
    unset PROJECT TASK API_HOST API_CONTAINER
    source "$f"
    [ -n "${PROJECT:-}" ] && [ -n "${TASK:-}" ] && [ -n "${API_HOST:-}" ] && [ -n "${API_CONTAINER:-}" ] || continue
    [ -f "$(api_state "$PROJECT" "$TASK")" ] || write_api_state "$PROJECT" "$TASK" "$API_HOST" "$API_CONTAINER" '-'
    rm -f "$f"
    info "已迁移旧注册：${PROJECT}/${TASK}"
  done
}
main() {
  migrate_legacy_states
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    api-up) [ "$#" -ge 4 ] || { usage; exit 1; }; cmd_api_up "$@" ;;
    set-task) [ "$#" -eq 3 ] || { usage; exit 1; }; cmd_set_task "$@" ;;
    lib-up) [ "$#" -ge 4 ] || { usage; exit 1; }; cmd_lib_up "$@" ;;
    bind) [ "$#" -ge 4 ] || { usage; exit 1; }; cmd_bind "$@" ;;
    unbind) [ "$#" -eq 4 ] || { usage; exit 1; }; cmd_unbind "$@" ;;
    api-down|down) [ "$#" -eq 2 ] || { usage; exit 1; }; cmd_api_down "$@" ;;
    lib-down) [ "$#" -eq 2 ] || { usage; exit 1; }; cmd_lib_down "$@" ;;
    reload) [ "$#" -eq 0 ] || { usage; exit 1; }; reload_nginx ;;
    list) [ "$#" -eq 0 ] || { usage; exit 1; }; cmd_list ;;
    cli) [ "$#" -ge 3 ] || { usage; exit 1; }; cmd_cli "$@" ;;
    *) usage; exit 1 ;;
  esac
}
main "$@"
